{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Fresh-instance Azure baseline for Caldova. Creates an empty Azure SQL Database and a public bootstrap container. Run scripts/setup/Configure-ContainerApp.ps1 after deployment (scripts/setup/Deploy-LabInfrastructure.ps1 runs it for you)."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "nameSuffix": {
      "type": "string",
      "minLength": 5,
      "maxLength": 12,
      "metadata": {
        "description": "Lowercase letters and digits appended to resource names. Keeps the container registry and SQL server names globally unique."
      }
    },
    "sqlAdministratorPassword": {
      "type": "securestring",
      "minLength": 8,
      "maxLength": 128,
      "metadata": {
        "description": "Azure SQL administrator password. Use the same value for scripts/setup/Configure-ContainerApp.ps1. Must satisfy Azure SQL password requirements."
      }
    }
  },
  "variables": {
    "sqlServerName": "[concat('sql-caldova-', parameters('nameSuffix'))]",
    "databaseName": "CaldovaInventory",
    "sqlAdministratorLogin": "caldovaadmin",
    "registryName": "[concat('acrcaldova', parameters('nameSuffix'))]",
    "identityName": "[concat('id-caldova-', parameters('nameSuffix'))]",
    "workspaceName": "[concat('law-caldova-', parameters('nameSuffix'))]",
    "environmentName": "[concat('cae-caldova-', parameters('nameSuffix'))]",
    "containerAppName": "[concat('ca-caldova-', parameters('nameSuffix'))]",
    "bootstrapImage": "mcr.microsoft.com/k8se/quickstart@sha256:3a4d93c34c6753f24765ab17a36f1754aee9b02082b7d9553d17697b9e8252c4"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2018-11-30",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('registryName')]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "anonymousPullEnabled": false,
        "publicNetworkAccess": "Enabled",
        "policies": {
          "azureADAuthenticationAsArmPolicy": {
            "status": "enabled"
          }
        }
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[concat(variables('registryName'), '/Microsoft.Authorization/', guid(resourceGroup().id, variables('registryName'), variables('identityName'), 'AcrPull'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "properties": {
        "administratorLogin": "[variables('sqlAdministratorLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdministratorPassword')]",
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[concat(variables('sqlServerName'), '/AllowAllIPs')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "255.255.255.255"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[concat(variables('sqlServerName'), '/', variables('databaseName'))]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "sku": {
        "name": "Basic",
        "tier": "Basic",
        "capacity": 5
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 2147483648,
        "zoneRedundant": false,
        "readScale": "Disabled",
        "requestedBackupStorageRedundancy": "Geo"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases/backupShortTermRetentionPolicies",
      "apiVersion": "2023-08-01",
      "name": "[concat(variables('sqlServerName'), '/', variables('databaseName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), variables('databaseName'))]"
      ],
      "properties": {
        "retentionDays": 7
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('environmentName')]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').primarySharedKey]"
          }
        },
        "zoneRedundant": false,
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "LabInstance": "[parameters('nameSuffix')]",
        "Workload": "Caldova",
        "ProvisionedBy": "LabSetupScript"
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 80,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "inventory",
              "image": "[variables('bootstrapImage')]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 10
          }
        }
      }
    }
  ],
  "outputs": {
    "resourceGroup": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "sqlServerName": {
      "type": "string",
      "value": "[variables('sqlServerName')]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2023-08-01').fullyQualifiedDomainName]"
    },
    "databaseName": {
      "type": "string",
      "value": "[variables('databaseName')]"
    },
    "sqlAdministratorLogin": {
      "type": "string",
      "value": "[variables('sqlAdministratorLogin')]"
    },
    "registryName": {
      "type": "string",
      "value": "[variables('registryName')]"
    },
    "registryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]"
    },
    "identityResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
    },
    "workspaceName": {
      "type": "string",
      "value": "[variables('workspaceName')]"
    },
    "environmentName": {
      "type": "string",
      "value": "[variables('environmentName')]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[variables('containerAppName')]"
    },
    "applicationUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "bootstrapTargetPort": {
      "type": "int",
      "value": 80
    },
    "learnerApplicationTargetPort": {
      "type": "int",
      "value": 8080
    }
  }
}
